# MongoDB connection URI without a database suffix.
MONGODB_URI=mongodb://localhost:27017
# Database name selected separately from the URI.
MONGODB_DB=ketsip_local
# CORS origins as a comma-separated list for local frontend development.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Required: provide a private random secret; this placeholder is rejected at startup.
JWT_SECRET=
# Enables idempotent first-run demo data.
SEED_ON_STARTUP=true
# Required: inject a private value for deployment; this placeholder is not usable.
SEED_ADMIN_PASSWORD=
# Required when demo accounts are seeded; this placeholder is not usable.
SEED_DEMO_PASSWORD=
# Address bound by the API process.
PORT=8000
